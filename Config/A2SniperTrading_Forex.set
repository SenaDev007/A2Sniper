; Configuration optimisée pour le trading Forex
; A2Sniper Trading - Stratégie Heikin-Ashi
; Recommandé pour: EURUSD, GBPUSD, USDJPY, AUDUSD

; === INDICATEURS ===
EMA_Period=21
Use_VWAP=false
Volume_Period=10
ATR_Period=14

; === DETECTION PATTERNS ===
Min_Pullback_Candles=2
Doji_Body_Ratio=0.25
Volume_Multiplier=1.15

; === RISK MANAGEMENT ===
Risk_Percent=0.80
SL_Method=2
SL_Pips=15.00
ATR_Multiplier=1.80
RR_Ratio=2.50
Use_Trailing=true

; === FILTRES ===
Trading_Hours=08:00-17:00
Monday_Trading=false
Friday_Trading=false
Max_Spread=2.50

; === LIMITES ===
Max_Positions=2
Max_Daily_Loss=4.00
Max_Drawdown=8.00

; === NOTIFICATIONS ===
Send_Alerts=true
Debug_Mode=false
