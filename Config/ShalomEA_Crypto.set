; Configuration optimisée pour les Cryptomonnaies
; Shalom EA - Stratégie Heikin-Ashi
; Recommandé pour: BTCUSD, ETHUSD, ADAUSD, etc.

; === INDICATEURS ===
EMA_Period=18
Use_VWAP=true
Volume_Period=15
ATR_Period=12

; === DETECTION PATTERNS ===
Min_Pullback_Candles=3
Doji_Body_Ratio=0.35
Volume_Multiplier=1.30

; === RISK MANAGEMENT ===
Risk_Percent=1.50
SL_Method=2
SL_Pips=25.00
ATR_Multiplier=2.20
RR_Ratio=1.80
Use_Trailing=true

; === FILTRES ===
Trading_Hours=00:00-23:59
Monday_Trading=true
Friday_Trading=true
Max_Spread=5.00

; === LIMITES ===
Max_Positions=4
Max_Daily_Loss=6.00
Max_Drawdown=12.00

; === NOTIFICATIONS ===
Send_Alerts=true
Debug_Mode=false
