; A2Sniper Trading v6.3 - Configuration par defaut
; v6.3: Smart Partial Close - si volume=min_lot => BE@0.5R + FullClose@1R
; Copyright 2024, YEHI OR Tech Solutions

; === GENERAL ===
EnableAutoTrading=true
MagicNumber=20240720
GMT_Offset=0

; === ADAPTIVE RISK MANAGEMENT ===
RiskPercent=1.00
MaxDailyDD=5.00
MaxWeeklyDD=10.00
MaxMonthlyDD=20.00
MaxPositions=3
MaxDailyTrades=5
UseAdaptiveRisk=true

; === TRADE SNIPER (v6 - NE PAS MODIFIER MinRiskReward) ===
MinSniperScore=70
MinRiskReward=1.00
RequireKillzone=false
RequireStructure=false
RequireInstitutional=false

; === SIGNAL ===
MinSignalScore=60.00
MinSREScore=65
RequireSMEConfirmation=false
RequireSessionFilter=false
RequireNewsFilter=true

; === POSITION STATE MACHINE ===
EnableBreakEven=true
EnableTrailingStop=true
EnablePartialClose=true
EnableStructuralSL=true
TrailingMode=0

; === TIMEFRAME ===
HTF_Timeframe=4
MTF_Timeframe=1
LTF_Timeframe=15

; === ORDER BOOK ===
EnableOrderBook=true
RequireBookConfirmation=false
UseBookSLAdjust=true

; === DASHBOARD ===
EnableDashboard=true
